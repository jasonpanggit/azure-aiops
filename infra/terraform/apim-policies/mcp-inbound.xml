<policies>
  <inbound>
    <base />
    <validate-azure-ad-token tenant-id="${tenant_id}">
      <audiences>
        <audience>${audience}</audience>
        <audience>${audience_id}</audience>
      </audiences>
    </validate-azure-ad-token>
    <set-backend-service base-url="${backend_url}" />
    <set-header name="X-Correlation-ID" exists-action="override">
      <value>@(context.RequestId.ToString())</value>
    </set-header>
    <set-header name="X-AIOps-Validated-Gateway" exists-action="override">
      <value>true</value>
    </set-header>
    <!-- Never forward caller-controlled authorization or identity/scope claims. -->
    <set-header name="Authorization" exists-action="delete" />
    <set-header name="X-AIOps-Scope" exists-action="delete" />
    <set-header name="X-AIOps-Grant" exists-action="delete" />
    <set-header name="X-AIOps-Subscription" exists-action="delete" />
    <set-header name="X-AIOps-Principal" exists-action="delete" />
    <set-header name="X-MS-Client-Principal-Name" exists-action="override">
      <value>@(context.User.Id)</value>
    </set-header>
    <set-header name="X-MS-Client-Principal-Roles" exists-action="override">
      <value></value>
    </set-header>
    <set-header name="X-AIOps-Gateway-Assertion" exists-action="override">
      <value>${gateway_assertion}</value>
    </set-header>
    <rate-limit-by-key calls="60" renewal-period="60" counter-key="@(context.User.Id)" />
    <quota-by-key calls="10000" renewal-period="86400" counter-key="@(context.User.Id)" />
    <check-header name="Content-Type" failed-check-httpcode="415" failed-check-error-message="MCP requires JSON" ignore-case="true">
      <value>application/json</value>
    </check-header>
  </inbound>
  <backend><base /></backend>
  <outbound><base /></outbound>
  <on-error><base /></on-error>
</policies>
