<policies>
  <inbound>
    <base />
    <validate-azure-ad-token tenant-id="${tenant_id}">
      <audiences>
        <audience>${audience}</audience>
      </audiences>
      <required-claims>
        <claim name="iss">
          <value>https://login.microsoftonline.com/${tenant_id}/v2.0</value>
        </claim>
      </required-claims>
    </validate-azure-ad-token>
    <set-variable name="aiops-correlation-id" value="@((string)context.Request.Headers.GetValueOrDefault(&quot;x-correlation-id&quot;, Guid.NewGuid().ToString(&quot;N&quot;)))" />
    <set-header name="X-Correlation-ID" exists-action="override">
      <value>@((string)context.Variables[&quot;aiops-correlation-id&quot;])</value>
    </set-header>
    <set-header name="X-AIOps-Validated-Gateway" exists-action="override">
      <value>true</value>
    </set-header>
    <!-- Never forward caller-controlled authorization or identity/scope claims. -->
    <set-header name="Authorization" exists-action="delete" />
    <set-header name="X-AIOps-Scope" exists-action="delete" />
    <set-header name="X-AIOps-Grant" exists-action="delete" />
    <set-header name="X-AIOps-Subscription" exists-action="delete" />
    <set-header name="X-AIOps-Principal" exists-action="delete" />
    <set-header name="X-MS-Client-Principal-Name" exists-action="override">
      <value>@(context.User.Identity.Name)</value>
    </set-header>
    <set-header name="X-MS-Client-Principal-Roles" exists-action="override">
      <value>@(String.Join(",", context.User.Claims.Where(c => c.Type == "roles").Select(c => c.Value)))</value>
    </set-header>
    <set-header name="X-AIOps-Gateway-Assertion" exists-action="override">
      <value>${gateway_assertion}</value>
    </set-header>
    <rate-limit-by-key calls="60" renewal-period="60" counter-key="@(context.User.Identity.Name)" />
    <quota-by-key calls="10000" renewal-period="86400" counter-key="@(context.User.Identity.Name)" />
    <choose>
      <when condition="@(context.Request.Method == &quot;POST&quot; &amp;&amp; !new [] {&quot;initialize&quot;, &quot;tools/list&quot;, &quot;tools/call&quot;}.Contains(context.Request.Body.As&lt;JObject&gt;(preserveContent: true)[&quot;method&quot;]?.ToString()))">
        <return-response><set-status code="400" reason="Unsupported MCP method" /></return-response>
      </when>
      <when condition="@(context.Request.Body.As&lt;JObject&gt;(preserveContent: true).ToString().Length &gt; 262144)">
        <return-response><set-status code="413" reason="MCP request too large" /></return-response>
      </when>
    </choose>
  </inbound>
  <backend><base /></backend>
  <outbound><base /></outbound>
  <on-error><base /></on-error>
</policies>
