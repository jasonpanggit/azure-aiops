# Copy to .env.local for local development. Next.js only exposes vars
# prefixed NEXT_PUBLIC_ to the browser bundle — never put secrets here.

# Operations API base URL (see docs/OPERATIONS_API.md). Defaults to
# http://127.0.0.1:8080 if unset.
NEXT_PUBLIC_HERMES_API_BASE_URL=http://127.0.0.1:8080
# Must match the local API token generated by scripts/start-api.sh.
# Intentionally NOT prefixed NEXT_PUBLIC_: it's read server-side only, by the
# /api/dev-token route handler, and fetched by the browser from there. This
# keeps the token out of the public build output.
HERMES_DEV_TOKEN=local-dev-token-1234

# Dev-token mode: when NEXT_PUBLIC_ENTRA_CLIENT_ID is unset, this bearer
# token is sent on every request instead of an MSAL access token. The API
# script derives its local HERMES_API_TOKENS map from this value.
# NEVER set this in a production deployment.

## Azure Service Principal credentials for local development. These values are used to authenticate with Azure services when running the application locally. Make sure to keep these credentials secure and do not expose them in public repositories. 

AZURE_SUBSCRIPTION_ID="<your-subscription-id>"
AZURE_TENANT_ID="<your-tenant-id>"
AZURE_CLIENT_ID="<your-client-id>"
AZURE_CLIENT_SECRET="<your-client-secret>"

NVD_URL="https://services.nvd.nist.gov/rest/json/cves/2.0"
NVD_API_KEY="<your-nvd-api-key>"