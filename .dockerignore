# Build context is the repository root; only the API's own inputs are needed.
.git
.github
.venv
.pytest_cache
.ruff_cache
__pycache__
**/__pycache__
*.pyc

# The web app has its own image and build context.
web
dist
graphify-out

# Local state and generated datasets must never enter the image.
data
live-data
sample-data
mock-fabric-lakehouse
config.yaml
fabric.config.yaml
fabric.local.yaml
*.env
.env*

# Docs and infrastructure are not runtime inputs.
docs
infra
tests
*.md
