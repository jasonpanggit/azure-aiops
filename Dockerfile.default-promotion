ARG AIOPS_CANARY_BASE_IMAGE
FROM ${AIOPS_CANARY_BASE_IMAGE}

ARG AIOPS_CANARY_BASE_IMAGE

COPY src/operations/copilot_default_authorization.v1.json /app/src/operations/copilot_default_authorization.v1.json

RUN PYTHONPATH=/app/src python -c 'import hashlib,json,pathlib,re,sys; from operations.copilot_canary_authorization import DefaultAuthorizationManifest,default_promotion_equivalence_sha256; image=sys.argv[1]; match=re.fullmatch(r".+@(sha256:[0-9a-f]{64})",image); assert match, "AIOPS_CANARY_BASE_IMAGE must be an immutable image reference"; digest=match.group(1); metadata_path=pathlib.Path("/app/build-metadata.json"); manifest_path=pathlib.Path("/app/src/operations/copilot_default_authorization.v1.json"); metadata=json.loads(metadata_path.read_text(encoding="utf-8")); manifest=DefaultAuthorizationManifest.model_validate_json(manifest_path.read_text(encoding="utf-8")); lineage=manifest.promotion_lineage; assert metadata == {key: metadata[key] for key in ("schema_version","source_revision","canary_authorization_manifest_sha256","default_authorization_manifest_sha256","reviewed_tree_sha256")}, "base image already carries promotion metadata"; assert metadata["schema_version"] == "copilot-build-metadata.v1"; assert metadata["source_revision"] == lineage.base_source_revision; assert metadata["reviewed_tree_sha256"] == lineage.equivalent_reviewed_tree_sha256; assert digest == lineage.base_image_digest; assert default_promotion_equivalence_sha256(lineage) == lineage.equivalence_proof.sha256; metadata["default_authorization_manifest_sha256"]=hashlib.sha256(manifest_path.read_bytes()).hexdigest(); metadata["default_promotion"]=lineage.model_dump(mode="json"); metadata_path.write_text(json.dumps(metadata,sort_keys=True,separators=(",",":"))+"\n",encoding="utf-8")' "${AIOPS_CANARY_BASE_IMAGE}"
